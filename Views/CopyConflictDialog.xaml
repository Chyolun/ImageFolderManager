<mah:MetroWindow x:Class="ImageFolderManager.Views.CopyConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Folder Already Exists"
        Height="210"
        Width="500"
        MinHeight="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + main message -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Width="26" Height="26" Margin="0,2,12,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Canvas Width="24" Height="24">
                    <Path Fill="{DynamicResource MahApps.Brushes.Accent}"
                          Data="M1,21H23L12,2L1,21Z M13,18H11V16H13V18Z M13,14H11V10H13V14Z"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        </Grid>

        <!-- Destination path hint -->
        <TextBlock x:Name="DestPathText"
                   Grid.Row="1"
                   FontSize="12"
                   Foreground="DarkOrange"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <!-- New name input (visible only for Rename option) -->
        <StackPanel Grid.Row="2" x:Name="RenamePanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="New folder name:"
                       FontSize="11"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="NewNameTextBox"
                     FontSize="12"
                     mah:TextBoxHelper.ClearTextButton="True"
                     TextChanged="NewNameTextBox_TextChanged"/>
            <TextBlock x:Name="NameValidationText"
                       FontSize="11"
                       Foreground="OrangeRed"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Apply-to-all checkbox (visible when batch) -->
        <CheckBox x:Name="ApplyToAllCheck"
                  Grid.Row="3"
                  Content="Apply this action to all remaining conflicts"
                  FontSize="11"
                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                  Margin="0,0,0,0"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button x:Name="SkipButton"
                    Content="Skip"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="Skip_Click"/>

            <Button x:Name="RenameButton"
                    Content="Rename"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="Rename_Click"/>

            <Button x:Name="OverwriteButton"
                    Content="Overwrite"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButton}"
                    Click="Overwrite_Click"/>

            <Button Content="Cancel All"
                    MinWidth="80"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    Click="CancelAll_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
