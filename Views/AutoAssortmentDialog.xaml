<mah:MetroWindow x:Class="ImageFolderManager.Views.AutoAssortmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Auto Assortment"
        Height="680"
        Width="1120"
        MinHeight="560"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Review auto assortment targets"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"/>
                <TextBlock x:Name="SummaryTextBlock"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource App.Brush.TextSecondary}"/>
                <TextBlock x:Name="HintTextBlock"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource StatusInfoBrush}"
                           FontSize="11"
                           Text="Rule: file names that contain a full author name are preferred; otherwise fragments of 5 or more characters are used."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Select All Matched"
                        Click="SelectAllMatched_Click"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        MinWidth="136"/>
                <Button Content="Skip Unmatched"
                        Click="SkipUnmatched_Click"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        MinWidth="120"/>
                <Button Content="Move All Visible"
                        Click="MoveAllVisible_Click"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="132"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionCard}">
            <DataGrid x:Name="ItemsDataGrid"
                      ItemsSource="{Binding ReviewItems, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Move"
                                            Binding="{Binding ShouldMove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="64"/>
                    <DataGridTextColumn Header="Folder"
                                        Binding="{Binding SourceFolderName}"
                                        Width="180"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Source Path"
                                        Binding="{Binding RelativeSourcePath}"
                                        Width="230"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Match"
                                        Binding="{Binding MatchSummary}"
                                        Width="300"
                                        IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Target Author Folder" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding TargetOptions}"
                                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayText"
                                          MinWidth="200"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Destination Preview"
                                        Binding="{Binding DestinationPreview}"
                                        Width="*"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Style="{StaticResource DialogFooterPanel}" Margin="0,12,0,0">
            <TextBlock x:Name="FooterStatusTextBlock"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"
                       Foreground="{DynamicResource App.Brush.TextMuted}"
                       FontSize="11"/>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="84"
                    Margin="{StaticResource DialogButtonSpacing}"/>
            <Button Content="Apply"
                    Click="Apply_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="96"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
