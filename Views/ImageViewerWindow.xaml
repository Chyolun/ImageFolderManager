<mah:MetroWindow x:Class="ImageFolderManager.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Image Viewer"
        Height="760"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" Padding="8">
            <DockPanel>
                <TextBlock x:Name="FileNameText"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           Margin="6,0,0,0" />
            </DockPanel>
        </Border>

        <Grid x:Name="ImageAreaHost"
              Grid.Row="1"
              Background="#0F0F0F"
              MouseMove="ImageAreaHost_MouseMove"
              MouseLeave="ImageAreaHost_MouseLeave">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#0F0F0F"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="ImageScrollViewer_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="ImageScrollViewer_PreviewMouseLeftButtonUp"
                          MouseLeave="ImageScrollViewer_MouseLeave">
                <Grid>
                    <Image x:Name="ViewerImage"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True">
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
                        </Image.LayoutTransform>
                    </Image>
                </Grid>
            </ScrollViewer>

            <Button x:Name="LeftNavButton"
                    Content="&#xE76B;"
                    FontFamily="Segoe MDL2 Assets"
                    Width="52"
                    Height="52"
                    FontSize="34"
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Click="PrevButton_Click"
                    ToolTip="Previous (Left Arrow)"
                    Background="#67DDA6"
                    Foreground="White"
                    BorderBrush="#B7FADF"
                    BorderThickness="1.5"
                    Visibility="Collapsed"
                    Focusable="False">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#67DDA6" />
                        <Setter Property="BorderBrush" Value="#B7FADF" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Shadow"
                                                Background="#66000000"
                                                CornerRadius="26"
                                                Margin="0,2,0,0" />
                                        <Border x:Name="Base"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="26">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#8EF2C5" Offset="0" />
                                                    <GradientStop Color="#58D59A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Height="18"
                                                 VerticalAlignment="Top"
                                                 Margin="10,6,10,0"
                                                 IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#A0FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#86F0BF" />
                                <Setter Property="BorderBrush" Value="#E8FFF5" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="RightNavButton"
                    Content="&#xE76C;"
                    FontFamily="Segoe MDL2 Assets"
                    Width="52"
                    Height="52"
                    FontSize="34"
                    FontWeight="Bold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Click="NextButton_Click"
                    ToolTip="Next (Right Arrow)"
                    Background="#67DDA6"
                    Foreground="White"
                    BorderBrush="#B7FADF"
                    BorderThickness="1.5"
                    Visibility="Collapsed"
                    Focusable="False">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#67DDA6" />
                        <Setter Property="BorderBrush" Value="#B7FADF" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Shadow"
                                                Background="#66000000"
                                                CornerRadius="26"
                                                Margin="0,2,0,0" />
                                        <Border x:Name="Base"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="26">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#8EF2C5" Offset="0" />
                                                    <GradientStop Color="#58D59A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Ellipse Height="18"
                                                 VerticalAlignment="Top"
                                                 Margin="10,6,10,0"
                                                 IsHitTestVisible="False">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#A0FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#86F0BF" />
                                <Setter Property="BorderBrush" Value="#E8FFF5" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="#1E1E1E" Padding="8">
            <DockPanel>
                <TextBlock x:Name="IndexText"
                           DockPanel.Dock="Left"
                           Foreground="#D0D0D0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ZoomText"
                           DockPanel.Dock="Right"
                           Foreground="#D0D0D0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="InfoText"
                           Foreground="#D0D0D0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="14,0,14,0" />
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
