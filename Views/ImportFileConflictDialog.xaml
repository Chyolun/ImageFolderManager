<mah:MetroWindow x:Class="ImageFolderManager.Views.ImportFileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="File Already Exists"
        Height="240"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + main message -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Width="26" Height="26" Margin="0,2,12,0"
                     VerticalAlignment="Top" HorizontalAlignment="Left">
                <Canvas Width="24" Height="24">
                    <!-- Question / info circle -->
                    <Path Fill="{DynamicResource MahApps.Brushes.Accent}"
                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z
                                M13,17H11V15H13V17Z M13,13H11V7H13V13Z"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        </Grid>

        <!-- Destination path hint -->
        <TextBlock x:Name="DestPathText"
                   Grid.Row="1"
                   FontSize="12"
                   Foreground="DarkOrange"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4"/>

        <!-- Apply-to-all checkbox -->
        <CheckBox x:Name="ApplyToAllCheck"
                  Grid.Row="3"
                  Content="Apply this choice to all remaining file conflicts in this folder"
                  FontSize="11"
                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                  Margin="0,0,0,0"
                  VerticalAlignment="Bottom"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button x:Name="OverwriteButton"
                    Content="Overwrite"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Style="{StaticResource DangerButton}"
                    Click="Overwrite_Click"/>

            <Button x:Name="SkipButton"
                    Content="Skip"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="Skip_Click"/>

            <Button Content="Cancel Import"
                    MinWidth="100"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    Click="CancelImport_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
