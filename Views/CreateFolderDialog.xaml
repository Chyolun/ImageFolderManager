<mah:MetroWindow x:Class="ImageFolderManager.Views.CreateFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Create New Folder"
        Height="210"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <!-- Description -->
            <RowDefinition Height="Auto"/>
            <!-- Parent path row -->
            <RowDefinition Height="Auto"/>
            <!-- Folder name input row -->
            <RowDefinition Height="Auto"/>
            <!-- Spacer -->
            <RowDefinition Height="*"/>
            <!-- Button footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0"
                   Text="Enter a name for the new folder."
                   FontSize="12"
                   Foreground="{StaticResource StatusMutedBrush}"
                   Margin="0,0,0,16"/>

        <!-- Parent folder path (read-only, selectable) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Location:"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>

            <!--
                Shows the parent folder path so the user knows where
                the new folder will be created.
                IsReadOnly + Cursor="IBeam" lets them select and copy it.
            -->
            <TextBox Grid.Column="1"
                     x:Name="ParentPathText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Cursor="IBeam"
                     FontSize="11"
                     Foreground="{StaticResource StatusMutedBrush}"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Grid>

        <!-- New folder name input -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Folder name:"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>

            <TextBox Grid.Column="1"
                     x:Name="FolderNameTextBox"
                     mah:TextBoxHelper.ClearTextButton="True"
                     mah:TextBoxHelper.Watermark="Enter folder name…"
                     VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer: Cancel (secondary) + Create (primary) -->
        <StackPanel Grid.Row="4"
                    Style="{StaticResource DialogFooterPanel}">

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="{StaticResource DialogButtonSpacing}"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="Create"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
