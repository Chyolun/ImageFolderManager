<mah:MetroWindow
    x:Class="ImageFolderManager.Views.ImageCompressionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="Image Compression"
    Width="460"
    Height="400"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowMinButton="False"
    ShowMaxRestoreButton="False"
    TitleCharacterCasing="Normal"
    Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Folder name -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="&#x1F4C1;" FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="FolderNameText"
                       Text="Selected Folder"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                       FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="370"/>
        </StackPanel>

        <!-- Quality slider -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Compression Quality"
                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                           FontSize="12" Margin="0,0,0,5"/>
                <Slider x:Name="QualitySlider"
                        Minimum="1" Maximum="100" Value="80"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        SmallChange="1" LargeChange="10"
                        ValueChanged="QualitySlider_ValueChanged"/>
                <TextBlock Text="1 = smallest file,   100 = best quality"
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                           FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    CornerRadius="4" Margin="8,0,0,14"
                    VerticalAlignment="Center" Padding="4,2">
                <TextBlock x:Name="QualityValueText" Text="80"
                           Foreground="White" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Size preview panel -->
        <Border Grid.Row="4"
                Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1" CornerRadius="4" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Estimated Size Change"
                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                           FontSize="12" FontWeight="SemiBold"/>

                <!-- Before / After -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Before"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BeforeSizeText" Text="—"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="&#x2192;"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               FontSize="18" VerticalAlignment="Center"
                               Margin="10,4,10,0"/>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="After (estimated)"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                   FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AfterSizeText" Text="—"
                                   Foreground="#FF4FC3F7"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Calculating spinner -->
                <ProgressBar x:Name="EstimateProgress"
                             Grid.Row="4" Height="3"
                             IsIndeterminate="True" Visibility="Collapsed"/>

                <!-- Saved label -->
                <TextBlock x:Name="SavedText" Grid.Row="4"
                           Text="" Foreground="#FF81C784"
                           FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>

                <!-- Note -->
                <TextBlock x:Name="EstimateNote" Grid.Row="6"
                           Text="Calculating estimate..."
                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                           FontSize="10" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Delete source checkbox -->
        <CheckBox x:Name="DeleteSourceCheckBox"
                  Grid.Row="6"
                  Content="Delete source files after compression"
                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                  FontSize="13" IsChecked="False"
                  Checked="DeleteSourceCheckBox_CheckedChanged"
                  Unchecked="DeleteSourceCheckBox_CheckedChanged"/>

        <!-- Delete warning -->
        <TextBlock x:Name="DeleteWarningText"
                   Grid.Row="7"
                   Text="Original images will be permanently deleted. This cannot be undone."
                   Foreground="#FFFFB74D"
                   FontSize="11" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Width="80" IsCancel="True"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="CompressButton"
                    Content="Compress"
                    Style="{StaticResource PrimaryButton}"
                    Width="90" IsDefault="True"
                    Click="CompressButton_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
