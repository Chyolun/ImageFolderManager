<mah:MetroWindow x:Class="ImageFolderManager.Views.RenameTagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Rename Tag"
        Height="210"
        Width="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="Rename the selected tag. This will update the tag in all folders."
                   TextWrapping="Wrap" Margin="0,0,0,20" Foreground="{DynamicResource App.Brush.TextPrimary}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Tag:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource App.Brush.TextPrimary}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CurrentTagText" Foreground="{StaticResource StatusSuccessBrush}" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="New Name:" VerticalAlignment="Center" Margin="0,10,10,0" Foreground="{DynamicResource App.Brush.TextPrimary}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="NewTagTextBox" Margin="0,10,0,0"/>

        <StackPanel  Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource DialogFooterPanel}" >
            <Button Content="Cancel" MinWidth="80" Margin="{StaticResource DialogButtonSpacing}" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Rename" MinWidth="80" Click="Rename_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
