<mah:MetroWindow x:Class="ImageFolderManager.Views.TagCloudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:views="clr-namespace:ImageFolderManager.Views"
        xmlns:viewmodels="clr-namespace:ImageFolderManager.ViewModels"
        mc:Ignorable="d"
        Title="Tag Cloud"
        Height="500"
        Width="700"
        MinWidth="600"
        MinHeight="400"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Brush.Window}">

    <Window.Resources>
        <!-- Style for tag buttons with animations and hover effects -->
        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CacheMode" Value="BitmapCache" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8" TargetName="border" />
                                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}" TargetName="border" />
                                <Setter Property="BorderThickness" Value="1" TargetName="border" />
                                <Setter Property="BorderBrush" Value="{Binding Color}" TargetName="border" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for category tabs -->
        <Style x:Key="CategoryTabStyle" TargetType="TabItem">
            <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                            Margin="12,8,12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface1}" TargetName="Border"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" TargetName="Border"/>
                                <Setter Property="BorderThickness" Value="1,1,1,0" TargetName="Border"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Brush.Hover}" TargetName="Border"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop zone highlight style -->
        <Style x:Key="DropZoneStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="DragOver">
                    <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource App.Brush.SuccessSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with title and controls -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Tag Cloud"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"/>

                <Button Grid.Column="1"
                        Name="AddCategoryButton"
                        Content="Add Category"
                        MinWidth="100"
                        Height="30"
                        Style="{StaticResource SecondaryButton}"
                        Click="AddCategoryButton_Click"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Name="RefreshButton"
                        Content="Refresh"
                        MinWidth="80"
                        Height="30"
                        Style="{StaticResource PrimaryButton}"
                        Click="RefreshButton_Click"
                        Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- Main content area with tabs -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}">
            <TabControl Name="CategoryTabControl"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        SelectionChanged="CategoryTabControl_SelectionChanged">

            <!-- Tab header template -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" 
                                AllowDrop="True"
                                Drop="TabHeader_Drop"
                                DragOver="TabHeader_DragOver"
                                DragLeave="TabHeader_DragLeave"
                                MouseRightButtonDown="TabHeader_RightClick">
                        <TextBlock Text="{Binding DisplayName}" 
                                   Foreground="{DynamicResource App.Brush.TextPrimary}" 
                                   VerticalAlignment="Center"/>

                       
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- Tab content template -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource DropZoneStyle}"
                            AllowDrop="True"
                            Drop="CategoryContent_Drop"
                            DragOver="CategoryContent_DragOver"
                            DragLeave="CategoryContent_DragLeave">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled"
                                      x:Name="TagScrollViewer">

                            <!-- Tag cloud content -->
                            <ItemsControl ItemsSource="{Binding DataContext.TagItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                          x:Name="TagItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" IsItemsHost="True"
                                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TagButtonStyle}"
                                                Click="TagButton_Click"
                                                Tag="{Binding}"
                                                MouseRightButtonDown="TagButton_RightClick"
                                                PreviewMouseLeftButtonDown="TagButton_PreviewMouseDown"
                                                PreviewMouseMove="TagButton_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="TagButton_PreviewMouseUp"
                                                AllowDrop="True"
                                                ToolTip="{Binding CountDisplay}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="#" Foreground="{Binding Color}" FontSize="{Binding FontSize}" />
                                                <TextBlock Text="{Binding Tag}" Foreground="{Binding Color}" FontSize="{Binding FontSize}" />
                                                <TextBlock Text="{Binding Count}" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="10" 
                                                           VerticalAlignment="Top" Margin="2,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>

            <!-- Custom tab item container style -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource CategoryTabStyle}"/>
            </TabControl.ItemContainerStyle>
            </TabControl>
        </Border>

        <!-- Footer with status -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,10,0,0" Padding="10,8">
            <TextBlock x:Name="StatusText" 
                       Text="Right-click on tags to move them between categories" 
                       Foreground="{DynamicResource App.Brush.TextMuted}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</mah:MetroWindow>
