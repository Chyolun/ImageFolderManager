<mah:MetroWindow x:Class="ImageFolderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ImageFolderManager.Views"
        xmlns:controls="clr-namespace:ImageFolderManager.Controls"
        xmlns:converters="clr-namespace:ImageFolderManager.Converters"
        xmlns:local="clr-namespace:ImageFolderManager.ViewModels"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Image Folder Manager"
        Height="600"
        Width="1000"
        GlowBrush="{DynamicResource AccentColorBrush}"
        BorderBrush="{DynamicResource AccentColorBrush}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <!-- Set the DataContext to MainViewModel -->
    <mah:MetroWindow.DataContext>
        <local:MainViewModel />
    </mah:MetroWindow.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding CollapseParentDirectoryCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TagsCloudCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding}" 
                CommandParameter="FindBar"
                x:Name="FindKeyBinding"/>


    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Find Bar -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <MenuItem Header="File" Foreground="White">
                <MenuItem Header="Import Folder" Click="ImportFolder_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📥" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🚪" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Settings" Foreground="White">
                <MenuItem.Icon>
                    <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" />
                </MenuItem.Icon>
                <MenuItem Header="Root Directory" Click="RootDirectory_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Preview Settings" Click="PreviewSize_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🖼️" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Edit" Foreground="White">
                <MenuItem.Icon>
                    <TextBlock Text="✏️" FontSize="14" VerticalAlignment="Center" />
                </MenuItem.Icon>
                <MenuItem Header="Cut" 
              Command="{Binding CutCommand}" 
              InputGestureText="Ctrl+X">
                    <MenuItem.Icon>
                        <TextBlock Text="✂️" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy" 
              Command="{Binding CopyCommand}" 
              InputGestureText="Ctrl+C">
                    <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paste" 
              Command="{Binding PasteCommand}" 
              InputGestureText="Ctrl+V">
                    <MenuItem.Icon>
                        <TextBlock Text="📌" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete" 
              Command="{Binding DeleteCommand}" 
              InputGestureText="Delete">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑️" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Find"
                          Click="Find_Click"
                          InputGestureText="Ctrl+F">
                    <MenuItem.Icon>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding UndoDescription, StringFormat='Undo: {0}', FallbackValue='Undo'}"
          Command="{Binding UndoCommand}"
          IsEnabled="{Binding CanUndo}"
          InputGestureText="Ctrl+Z">
                    <MenuItem.Icon>
                        <TextBlock Text="↩" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Tools" Foreground="White">
                <MenuItem.Icon>
                    <TextBlock Text="🔧" FontSize="14" VerticalAlignment="Center" />
                </MenuItem.Icon>
                <MenuItem Header="Refresh Folder Tree" Click="RefreshAll_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Tags Cloud" Click="TagsCloud_Click" >
                    <MenuItem.Icon>
                        <TextBlock Text="🏷" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Find Duplicate Folders" Click="FindDuplicateFolders_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="👥" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Compression" Click="Compression_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🗜️" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse Parent Directory" Click="CollapseParentDirectory_Click" >
                    <MenuItem.Icon>
                        <TextBlock Text="↑" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
               
            </MenuItem>

            <MenuItem Header="Help" Foreground="White">
                <MenuItem.Icon>
                    <TextBlock Text="❓" FontSize="14" VerticalAlignment="Center" />
                </MenuItem.Icon>
                <MenuItem Header="User Guide" Click="UserGuide_Click" >
                    <MenuItem.Icon>
                        <TextBlock Text="📖" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="About" Click="About_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Border x:Name="FindBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 🔍 label -->
                <TextBlock Grid.Column="0"
                           Text="🔍"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="2,0,6,0"
                           Foreground="#CCCCCC"/>

                <!-- Search TextBox -->
                <TextBox  Grid.Column="1"
                          x:Name="FindTextBox"
                          Background="#3C3C3C"
                          Foreground="White"
                          CaretBrush="White"
                          BorderBrush="#555555"
                          BorderThickness="1"
                          Padding="4,2"
                          FontSize="13"
                          VerticalContentAlignment="Center"
                          TextChanged="FindTextBox_TextChanged"
                          KeyDown="FindTextBox_KeyDown"/>

                <!-- ← Prev -->
                <Button   Grid.Column="2"
                          x:Name="FindPrevButton"
                          Content="←"
                          Width="28" Height="24"
                          Margin="4,0,2,0"
                          FontSize="14"
                          ToolTip="Previous match (Shift+Enter)"
                          Click="FindPrev_Click"
                          Background="#3C3C3C"
                          Foreground="White"
                          BorderBrush="#555555"
                          BorderThickness="1"/>

                <!-- → Next -->
                <Button   Grid.Column="3"
                          x:Name="FindNextButton"
                          Content="→"
                          Width="28" Height="24"
                          Margin="2,0,4,0"
                          FontSize="14"
                          ToolTip="Next match (Enter)"
                          Click="FindNext_Click"
                          Background="#3C3C3C"
                          Foreground="White"
                          BorderBrush="#555555"
                          BorderThickness="1"/>

                <!-- Match counter "2 / 15" -->
                <TextBlock Grid.Column="4"
                           x:Name="FindMatchLabel"
                           Foreground="#AAAAAA"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Text=""/>

                <!-- No-match hint -->
                <TextBlock Grid.Column="5"
                           x:Name="FindNoMatchLabel"
                           Foreground="#E05555"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text=""
                           Visibility="Collapsed"/>

                <!-- ✕ Close -->
                <Button   Grid.Column="6"
                          Content="✕"
                          Width="22" Height="22"
                          Margin="6,0,2,0"
                          FontSize="11"
                          ToolTip="Close (Escape)"
                          Click="FindClose_Click"
                          Background="Transparent"
                          Foreground="#AAAAAA"
                          BorderThickness="0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <!-- ShellTreeView with star sizing and minimum height -->
                    <RowDefinition Height="*" MinHeight="100" />
                    <!-- Splitter between tree view and search results -->
                    <RowDefinition Height="5" />
                    <!-- Search Results section with star sizing and minimum height -->
                    <RowDefinition Height="*" MinHeight="125" />
                </Grid.RowDefinitions>

                <!-- ShellTreeView -->
                <controls:ShellTreeView Grid.Row="0" x:Name="ShellTreeViewControl" 
                        FolderSelected="OnFolderSelected"
                        DataContext="{Binding}" />

                <!-- Vertical Splitter - user can adjust relative heights -->
                <GridSplitter Grid.Row="1"
                  Height="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Background="Gray"
                  ShowsPreview="True" />

                <!-- Search Results Section (contains both title and list) -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <!-- Fixed height for title -->
                        <RowDefinition Height="*" />
                        <!-- Remaining space for the list -->
                    </Grid.RowDefinitions>

                    <!-- Search Results Header - always stays with the list -->
                    <TextBlock Grid.Row="0" 
                  Text="Search Results" 
                  FontSize="13" 
                  Foreground="LightGreen" 
                  FontWeight="Bold" 
                  Margin="5,2,5,0"/>

                    <!-- Search Results List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding SearchResultFolders}"
               
                   ContextMenuOpening="SearchResultListBox_ContextMenuOpening"
                   SelectionChanged="SearchResults_SelectionChanged"
                   MouseDoubleClick="SearchResults_MouseDoubleClick"
                   Background="Transparent"
                   BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" 
                                Padding="5" 
                                Margin="0,2" 
                                CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Folder Name -->
                                            <TextBlock Grid.Row="0" 
                                          Text="{Binding Name}" 
                                          Foreground="White" 
                                          FontWeight="SemiBold"/>

                                            <!-- Folder Path -->
                                            <TextBlock Grid.Row="1" 
                                          Text="{Binding FolderPath}" 
                                          Foreground="Gray" 
                                          FontSize="10" 
                                          TextTrimming="CharacterEllipsis"/>

                                            <!-- Rating and Tags on the same line -->
                                            <StackPanel Grid.Row="2" 
                                           Orientation="Horizontal" 
                                           Margin="0,3,0,0">

                                                <!-- Rating Stars -->
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStarsDisplayConverter}}"
                                             Foreground="Gold"
                                             FontSize="14"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>

                                                <!-- Tags with "No tags" fallback -->
                                                <TextBlock Text="{Binding Tags, Converter={StaticResource TagsToStringConverter}}" 
                                             Foreground="LightGreen" 
                                             FontSize="11" 
                                             VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3F3F3F"/>
                                            <Setter Property="BorderBrush" Value="#1E90FF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Gray"
                      ShowsPreview="True" />

            <!-- Right Panel -->
            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <!-- Search bar -->
                    <RowDefinition Height="*"/>
                    <!-- Image area -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tag & rating area -->
                    <RowDefinition Height="30"/>
                    <!-- message -->
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,0,0">
                    <TextBox Width="500" Margin="5,0,0,5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                               Background="Black"
                               Foreground="White">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                        Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Search" Width="50" Margin="5,0,0,5"
                           Command="{Binding SearchCommand}" />
                </StackPanel>

                <!-- Image preview -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <controls:AnimatedImageControl
                                        Frames="{Binding AnimatedFrames}"
                                        Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.PreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Tag="{Binding FilePath}"
                                        MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
                                    <Image Source="{Binding Thumbnail}"
                                       Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Height="{Binding DataContext.PreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Tag="{Binding FilePath}" 
                                       MouseLeftButtonDown="Image_MouseLeftButtonDown" />
                                    <TextBlock Text="{Binding FileName}"
                                       Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="10"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Tag + Rating area -->
                <GroupBox Header="Folder Info" Grid.Row="2" Margin="0,10,0,0" Foreground="White">
                    <StackPanel>
                        <!-- Current Folder Path -->
                        <TextBox Text="{Binding SelectedFolder.FolderPath, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Foreground="LightGray"
                             FontSize="13"
                             TextWrapping="Wrap"
                             Cursor="IBeam"
                             Margin="0,0,0,10"
                             ToolTip="Click to select · Ctrl+A to select all · Ctrl+C to copy"/>

                        <!-- Rating -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock Text="Rating:" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                            <ItemsControl ItemsSource="{Binding Stars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Symbol}"
                                    Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Value}"
                                    FontSize="20"
                                    Foreground="Gold"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Space -->
                        <Border Height="10"/>

                        <!-- Saved Tags display -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ItemsControl Grid.Column="0" 
                                  ItemsSource="{Binding TagManagement.TagDisplayItems}"
                                  x:Name="TagItemsControl">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TagManagement.TagDisplayItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,5,5" 
                                            Background="#2A2A2A" 
                                            CornerRadius="4" 
                                            Padding="5,2">
                                            <TextBlock Text="{Binding DisplayText}" 
                                               Foreground="LightGreen" 
                                               FontWeight="SemiBold"
                                               ToolTip="{Binding TooltipText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Fallback message when no tags -->
                            <TextBlock Grid.Column="0" 
                                   Text="No tags" 
                                   Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TagManagement.TagDisplayItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Content="Edit" 
                               Grid.Column="1"
                               MinWidth="80"
                               Height="24"
                               Margin="5,0,0,10"
                               HorizontalAlignment="Right"
                               Command="{Binding EditTagsCommand}"/>
                        </Grid>
                        <!-- Tags input -->
                        <StackPanel>
                            <TextBlock Text="Tags (use # to separate, Category::TagName for categories):" 
                               Foreground="White" 
                               Margin="0,5,0,5"/>   
                            <Grid>
                                <TextBox Text="{Binding TagInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Name="TagsTextBox">
                                    <TextBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Tag Format Examples:" FontWeight="Bold"/>
                                                <TextBlock Text="• Simple tags: #nature #sunset #beach"/>
                                                <TextBlock Text="• Tags with categories: #Landscape::mountain #Season::winter"/>
                                                <TextBlock Text="• Tags with spaces: #photon book #digital art"/>
                                                <TextBlock Text="• Mixed format: #clothing::glasses # photon book #IP"/>
                                                <TextBlock Text="• Spaces around # are ignored: # nature #  sunset  #beach"/>
                                                <TextBlock Text=""/>
                                                <TextBlock Text="Rules:" FontWeight="Bold"/>
                                                <TextBlock Text="• Use # as the only separator between tags"/>
                                                <TextBlock Text="• Spaces before and after # are ignored"/>
                                                <TextBlock Text="• Tag names can contain spaces"/>
                                                <TextBlock Text="• Use Category::TagName for categorized tags"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Text="Enter tags with # separator, spaces around # are ignored" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="10,0,0,0"
                                   Foreground="Gray"
                                   IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TagsTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <!-- Save button -->
                        <Button Content="Update" Width="150" Margin="0,10,0,0"
                                     Command="{Binding SaveTagsCommand}"/>
                    </StackPanel>
                </GroupBox>
                
                
                <StackPanel Grid.Row="3" Margin="10,5,20,3">
                    <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="LightGray" 
                       TextWrapping="Wrap"
                       Margin="5"/>
                    <!-- Real-time indexing status -->
                    <Border Background="Green" 
                            CornerRadius="3" 
                            Padding="5,2" 
                            Margin="10,0"
                            Visibility="{Binding IsRealTimeIndexingActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="White" FontSize="8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="Real-time" Foreground="White" FontSize="10"/>
                        </StackPanel>   
                    </Border>       

                    <!-- Indexed folder count -->
                    <TextBlock Text="{Binding IndexedFolderCount, StringFormat='{}{0} folders indexed'}" 
                           Foreground="#888888" 
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="5,0"/>   

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>