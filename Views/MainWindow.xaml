<mah:MetroWindow x:Class="ImageFolderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ImageFolderManager.Views"
        xmlns:controls="clr-namespace:ImageFolderManager.Controls"
        xmlns:converters="clr-namespace:ImageFolderManager.Converters"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Image Folder Manager"
        Height="720"
        Width="1220"
        MinHeight="620"
        MinWidth="980"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Brush.Window}">

    <mah:MetroWindow.Resources>
        <Style x:Key="SearchResultListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.Brush.Hover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.Brush.Selection}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThumbnailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource App.Brush.Surface1}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderStrong}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.Brush.Selection}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                    <Setter Property="BorderThickness" Value="1.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </mah:MetroWindow.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding CollapseParentDirectoryCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TagsCloudCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding}" 
                CommandParameter="FindBar"
                x:Name="FindKeyBinding"/>


    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Find Bar -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0"
              Background="{DynamicResource App.Brush.Surface2}"
              Foreground="{DynamicResource App.Brush.TextPrimary}">
            <MenuItem Header="File">
                <MenuItem Header="Import Folder" Click="ImportFolder_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8B7;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8BB;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Settings">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE713;" />
                </MenuItem.Icon>
                <MenuItem Header="Root Directory" Click="RootDirectory_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE838;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Preview Settings" Click="PreviewSize_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE91B;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="AutoExpandFoldersMenuItem"
                          Header="Auto Expand First Level"
                          IsCheckable="True"
                          Click="AutoExpandFolders_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8E5;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="RecentRootDirectoriesMenuItem"
                          Header="Recent Root Directories"
                          SubmenuOpened="RecentRootDirectories_SubmenuOpened">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE823;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE70F;" />
                </MenuItem.Icon>
                <MenuItem Header="Cut" 
              Command="{Binding CutCommand}" 
              InputGestureText="Ctrl+X">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8C6;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Copy" 
              Command="{Binding CopyCommand}" 
              InputGestureText="Ctrl+C">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8C8;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paste" 
              Command="{Binding PasteCommand}" 
              InputGestureText="Ctrl+V">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE77F;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete" 
              Command="{Binding DeleteCommand}" 
              InputGestureText="Delete">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE74D;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Find"
                          Click="Find_Click"
                          InputGestureText="Ctrl+F">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE721;" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding UndoDescription, StringFormat='Undo: {0}', FallbackValue='Undo'}"
          Command="{Binding UndoCommand}"
          IsEnabled="{Binding CanUndo}"
          InputGestureText="Ctrl+Z">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE7A7;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Tools">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE90F;" />
                </MenuItem.Icon>
                <MenuItem Header="Refresh Folder Tree" Click="RefreshAll_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE72C;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Tags Cloud" Click="TagsCloud_Click" >
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8EC;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Find Duplicate Folders" Click="FindDuplicateFolders_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE716;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Compression" Click="Compression_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE7B8;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Collapse Parent Directory" Click="CollapseParentDirectory_Click" >
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE70D;" />
                    </MenuItem.Icon>
                </MenuItem>
               
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE897;" />
                </MenuItem.Icon>
                <MenuItem Header="User Guide" Click="UserGuide_Click" >
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE8A5;" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="About" Click="About_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource MenuGlyphStyle}" Text="&#xE946;" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        <Border x:Name="FindBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource App.Brush.Surface2}"
                BorderBrush="{DynamicResource App.Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource MenuGlyphStyle}"
                           Text="&#xE721;"
                           Margin="2,0,8,0"/>

                <TextBox Grid.Column="1"
                         x:Name="FindTextBox"
                         Style="{StaticResource AppTextBoxStyle}"
                         TextChanged="FindTextBox_TextChanged"
                         KeyDown="FindTextBox_KeyDown"/>

                <Button Grid.Column="2"
                        x:Name="FindPrevButton"
                        Content="&#xE76B;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Margin="6,0,2,0"
                        ToolTip="Previous match (Shift+Enter)"
                        Click="FindPrev_Click"
                        Style="{StaticResource CompactIconButton}"/>

                <Button Grid.Column="3"
                        x:Name="FindNextButton"
                        Content="&#xE76C;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Margin="2,0,6,0"
                        ToolTip="Next match (Enter)"
                        Click="FindNext_Click"
                        Style="{StaticResource CompactIconButton}"/>

                <TextBlock Grid.Column="4"
                           x:Name="FindMatchLabel"
                           Foreground="{DynamicResource App.Brush.TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Text=""/>

                <TextBlock Grid.Column="5"
                           x:Name="FindNoMatchLabel"
                           Foreground="{StaticResource StatusErrorBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text=""
                           Visibility="Collapsed"/>

                <Button Grid.Column="6"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Width="24"
                        Height="24"
                        Margin="8,0,0,0"
                        ToolTip="Close (Escape)"
                        Click="FindClose_Click"
                        Style="{StaticResource CompactIconButton}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Grid Grid.Column="0" Margin="0">
                <Grid.RowDefinitions>
                    <!-- ShellTreeView with star sizing and minimum height -->
                    <RowDefinition Height="*" MinHeight="100" />
                    <!-- Splitter between tree view and search results -->
                    <RowDefinition Height="5" />
                    <!-- Search Results section with star sizing and minimum height -->
                    <RowDefinition Height="*" MinHeight="125" />
                </Grid.RowDefinitions>

                <!-- ShellTreeView -->
                <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="8">
                    <controls:ShellTreeView x:Name="ShellTreeViewControl" 
                            FolderSelected="OnFolderSelected"
                            DataContext="{Binding}" />
                </Border>

                <!-- Vertical Splitter - user can adjust relative heights -->
                <GridSplitter Grid.Row="1"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Background="{DynamicResource App.Brush.Border}"
                  ShowsPreview="True" />

                <!-- Search Results Section -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Search Results"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SearchResultFolders}"
                                 ContextMenuOpening="SearchResultListBox_ContextMenuOpening"
                                 SelectionChanged="SearchResults_SelectionChanged"
                                 MouseDoubleClick="SearchResults_MouseDoubleClick"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SearchResultListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            Padding="8"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource App.Brush.TextPrimary}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding FolderPath}"
                                                       Foreground="{DynamicResource App.Brush.TextMuted}"
                                                       FontSize="10"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToStarsDisplayConverter}}"
                                                           Foreground="{StaticResource StatusWarningBrush}"
                                                           FontSize="13"
                                                           Margin="0,0,8,0"/>

                                                <TextBlock Text="{Binding Tags, Converter={StaticResource TagsToStringConverter}}"
                                                           Foreground="{StaticResource StatusSuccessBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource App.Brush.Border}"
                      ShowsPreview="True" />

            <!-- Right Panel -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource MenuGlyphStyle}"
                                   Text="&#xE721;"
                                   Margin="0,0,8,0"/>

                        <TextBox Grid.Column="1"
                                 x:Name="SearchTextBox"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchTextBox_TextChanged"
                                 PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                            <TextBox.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="Search Syntax" FontWeight="Bold"/>
                                        <TextBlock Text="- #tag 或 #Category::Tag"/>
                                        <TextBlock Text="- @folderName"/>
                                        <TextBlock Text="- *>=4 / *=5 / *&lt;=2"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="2"
                                Content="Search"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource App.Brush.TextMuted}"
                                   FontSize="11"
                                   Text="Syntax: #Tag / #Category::Tag, @Folder, *>=4"/>

                        <Popup x:Name="SearchSuggestionPopup"
                               PlacementTarget="{Binding ElementName=SearchTextBox}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource App.Brush.Surface2}"
                                    BorderBrush="{DynamicResource App.Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MinWidth="360"
                                    MaxWidth="520"
                                    Padding="2">
                                <ListBox x:Name="SearchSuggestionListBox"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MouseDoubleClick="SearchSuggestionListBox_MouseDoubleClick"/>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Image preview -->
                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Image Preview" Style="{StaticResource SectionTitleText}"/>
                            <TextBlock Text="Click once to select, double-click to open viewer"
                                       Style="{StaticResource MutedText}"
                                       Margin="12,2,0,0"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ThumbnailCardStyle}">
                                            <StackPanel>
                                                <Border Background="{DynamicResource App.Brush.Surface3}"
                                                        CornerRadius="6"
                                                        BorderBrush="{DynamicResource App.Brush.Border}"
                                                        BorderThickness="1"
                                                        Padding="4">
                                                    <Image Source="{Binding Thumbnail}"
                                                           Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Height="{Binding DataContext.PreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Stretch="Uniform"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Tag="{Binding FilePath}"
                                                           MouseLeftButtonDown="Image_MouseLeftButtonDown" />
                                                </Border>
                                                <TextBlock Text="{Binding FileName}"
                                                           Width="{Binding DataContext.PreviewWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource App.Brush.TextSecondary}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Tag + Rating area -->
                <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Folder Info" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                        <!-- Current Folder Path -->
                        <TextBox Text="{Binding SelectedFolder.FolderPath, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Foreground="{DynamicResource App.Brush.TextSecondary}"
                             FontSize="13"
                             TextWrapping="Wrap"
                             Cursor="IBeam"
                             Margin="0,0,0,10"
                             ToolTip="Click to select. Ctrl+A select all. Ctrl+C copy."/>

                        <!-- Rating -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Rating:" VerticalAlignment="Center" Foreground="{DynamicResource App.Brush.TextPrimary}" Margin="0,0,10,0"/>
                            <ItemsControl ItemsSource="{Binding Stars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Symbol}"
                                    Command="{Binding DataContext.SetRatingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Value}"
                                    FontSize="20"
                                    Foreground="{StaticResource StatusWarningBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Saved Tags display -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ItemsControl Grid.Column="0" 
                                  ItemsSource="{Binding TagManagement.TagDisplayItems}"
                                  x:Name="TagItemsControl">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TagManagement.TagDisplayItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,5,5" 
                                            Background="{DynamicResource App.Brush.TagChip}"
                                            BorderBrush="{DynamicResource App.Brush.TagChipBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4" 
                                            Padding="5,2">
                                            <TextBlock Text="{Binding DisplayText}" 
                                               Foreground="{StaticResource StatusSuccessBrush}" 
                                               FontWeight="SemiBold"
                                               ToolTip="{Binding TooltipText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Fallback message when no tags -->
                            <TextBlock Grid.Column="0" 
                                   Text="No tags" 
                                   Foreground="{DynamicResource App.Brush.TextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TagManagement.TagDisplayItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Content="Edit" 
                               Grid.Column="1"
                               MinWidth="80"
                               Height="24"
                               Margin="8,0,0,0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SecondaryButton}"
                               Command="{Binding EditTagsCommand}"/>
                        </Grid>
                        <!-- Tags input -->
                        <StackPanel>
                            <TextBlock Text="Tags (use # to separate, Category::TagName for categories):" 
                               Foreground="{DynamicResource App.Brush.TextSecondary}" 
                               Margin="0,5,0,5"/>   
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding TagInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Name="TagsTextBox"
                                    Style="{StaticResource AppTextBoxStyle}"
                                    TextChanged="TagsTextBox_TextChanged"
                                    PreviewKeyDown="TagsTextBox_PreviewKeyDown">
                                    <TextBox.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="Tag Format Examples:" FontWeight="Bold"/>
                                                <TextBlock Text="- Simple tags: #nature #sunset #beach"/>
                                                <TextBlock Text="- Categories: #Landscape::mountain #Season::winter"/>
                                                <TextBlock Text="- Spaces in tag names are allowed"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Text="Enter tags with # separator, spaces around # are ignored" 
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="10,0,0,0"
                                   Foreground="{DynamicResource App.Brush.TextMuted}"
                                   IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TagsTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource App.Brush.TextMuted}"
                                           FontSize="11"
                                           Text="Tip: #Category::Tag 可直接输入或从下拉补全"/>

                                <Popup x:Name="TagSuggestionPopup"
                                       PlacementTarget="{Binding ElementName=TagsTextBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource App.Brush.Surface2}"
                                            BorderBrush="{DynamicResource App.Brush.BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            MinWidth="360"
                                            MaxWidth="520"
                                            Padding="2">
                                        <ListBox x:Name="TagSuggestionListBox"
                                                 MaxHeight="220"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MouseDoubleClick="TagSuggestionListBox_MouseDoubleClick"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                        <!-- Save button -->
                        <Button Content="Update" Width="150" Margin="0,10,0,0"
                                     Style="{StaticResource PrimaryButton}"
                                     Command="{Binding SaveTagsCommand}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{DynamicResource App.Brush.TextSecondary}" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>

                        <Border Style="{StaticResource StatusChipBorder}"
                                Margin="0,0,12,0"
                                Visibility="{Binding IsRealTimeIndexingActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource StatusSuccessBrush}"
                                           FontSize="10"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="Real-time"
                                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding IndexedFolderCount, StringFormat='{}{0} folders indexed'}" 
                                   Foreground="{DynamicResource App.Brush.TextMuted}" 
                                   FontSize="10"
                                   VerticalAlignment="Center"/>   
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
