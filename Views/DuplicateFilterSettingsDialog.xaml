<mah:MetroWindow x:Class="ImageFolderManager.Views.DuplicateFilterSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Duplicate Folder Filter Settings"
        Height="654"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Configure Duplicate Folder Detection Filters" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,20" 
                   Foreground="White"
                   TextWrapping="Wrap"/>

        <!-- Enable Filters Section -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}" 
                BorderThickness="1" 
                CornerRadius="5" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <CheckBox x:Name="EnableFiltersCheckBox" 
                          Content="Enable duplicate folder filters" 
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Foreground="White"
                          Checked="EnableFiltersCheckBox_Checked"
                          Unchecked="EnableFiltersCheckBox_Unchecked"/>
                <TextBlock Text="When enabled, folders will be filtered based on the criteria below before checking for duplicates." 
                           Foreground="LightGray" 
                           FontSize="11" 
                           TextWrapping="Wrap" 
                           Margin="20,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Filter Settings -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,37,-10,10" Grid.RowSpan="2">
            <StackPanel>

                <!-- Minimum Length Filter -->
                <StackPanel x:Name="MinLengthPanel" Margin="0,0,0,20">
                    <Border BorderBrush="Gray" 
                            BorderThickness="1" 
                            CornerRadius="5" 
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="Minimum Folder Name Length" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Folders with names shorter than this will be excluded from duplicate detection." 
                                       Foreground="LightGray" 
                                       FontSize="11" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <Slider x:Name="MinLengthSlider" 
                                        Grid.Column="0"
                                        Minimum="1" 
                                        Maximum="50" 
                                        Value="3" 
                                        TickFrequency="5" 
                                        TickPlacement="BottomRight"
                                        ValueChanged="MinLengthSlider_ValueChanged"
                                        Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1" 
                                           Text="characters" 
                                           VerticalAlignment="Center" 
                                           Foreground="LightGray" 
                                           Margin="5,0"/>

                                <TextBox x:Name="MinLengthTextBox" 
                                         Grid.Column="2"
                                         Text="3" 
                                         VerticalAlignment="Center"
                                         TextAlignment="Center"
                                         MaxLength="2"
                                         TextChanged="MinLengthTextBox_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Excluded Folder Names -->
                <StackPanel x:Name="ExclusionPanel">
                    <Border BorderBrush="Gray" 
                            BorderThickness="1" 
                            CornerRadius="5" 
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="Excluded Folder Names" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Folders with these exact names (case-insensitive) will be excluded from duplicate detection." 
                                       Foreground="LightGray" 
                                       FontSize="11" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,15"/>

                            <!-- Add new folder name -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="NewFolderNameTextBox" 
                                         Grid.Column="0"
                                         Margin="0,0,10,0" 
                                         mah:TextBoxHelper.Watermark="Enter folder name to exclude..."
                                         KeyDown="NewFolderNameTextBox_KeyDown"/>

                                <Button Grid.Column="1" 
                                        Content="Add" 
                                        Click="AddFolderName_Click" 
                                        MinWidth="60"/>
                            </Grid>

                            <!-- Excluded folders list -->
                            <TextBlock Text="Excluded Folder Names:" 
                                       Foreground="LightGray" 
                                       FontSize="11" 
                                       Margin="0,0,0,5"/>

                            <Border BorderBrush="DarkGray" 
                                    BorderThickness="1" 
                                    CornerRadius="3" 
                                    Height="120">
                                <ListBox x:Name="ExcludedFoldersListBox" 
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       Foreground="White" 
                                                       Padding="5,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Remove button -->
                            <Button Content="Remove Selected" 
                                    Click="RemoveFolderName_Click" 
                                    HorizontalAlignment="Left" 
                                    Margin="0,10,0,0" 
                                    MinWidth="120"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">

            <Button Content="Reset to Defaults" 
                    Click="ResetDefaults_Click" 
                    Margin="0,0,20,0" 
                    MinWidth="120" 
                    Background="DarkOrange"/>

            <Button Content="OK" 
                    Click="OK_Click" 
                    IsDefault="True" 
                    Margin="0,0,10,0" 
                    MinWidth="80" 
                    Background="{DynamicResource MahApps.Brushes.Accent}"/>

            <Button Content="Cancel" 
                    Click="Cancel_Click" 
                    IsCancel="True" 
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>