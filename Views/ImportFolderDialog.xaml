<mah:MetroWindow x:Class="ImageFolderManager.Views.ImportFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Import Folders"
        Width="640"
        MinHeight="380"
        MaxHeight="780"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Source folder -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Author -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: Skip info panel -->
            <RowDefinition Height="Auto"/>  <!-- Row 4: Separator -->
            <RowDefinition Height="Auto"/>  <!-- Row 5: Base path label -->
            <RowDefinition Height="Auto"/>  <!-- Row 6: Base path + Explore -->
            <RowDefinition Height="Auto"/>  <!-- Row 7: Final path preview -->
            <RowDefinition Height="Auto"/>  <!-- Row 8: Tags -->
            <RowDefinition Height="Auto"/>  <!-- Row 9: Status -->
            <RowDefinition Height="Auto"/>  <!-- Row 10: Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Row 0: Header -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   x:Name="HeaderText"
                   Text="Import Folders"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"
                   Foreground="White"/>

        <!-- Row 1: Source folder -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Source Folder:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                x:Name="SourceFolderText"
                Foreground="LightGreen"
                TextWrapping="Wrap"
                IsReadOnly="True"
                BorderThickness="0"
                Background="Transparent"/>

        <!-- Row 2: Author (editable) -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Author:" VerticalAlignment="Center" Margin="0,10,10,0" Foreground="White"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                x:Name="AuthorTextBox"
                Foreground="Yellow"
                Margin="0,10,0,0"
                TextChanged="AuthorTextBox_TextChanged"/>

        <!-- Row 3: Skip info panel -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3"
                       x:Name="SkipInfoPanel"
                       Visibility="Collapsed"
                       Margin="0,10,0,0">
            <Border Background="#33FFA500"
                        BorderBrush="Orange"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10">
                <StackPanel>
                    <TextBlock Text="⚠️ Skipped Folders"
                                  FontWeight="SemiBold"
                                  Foreground="Orange"
                                  Margin="0,0,0,5"/>
                    <ScrollViewer MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SkipInfoText"
                                      Foreground="LightGray"
                                      TextWrapping="Wrap"
                                      FontSize="11"
                                      LineHeight="16"
                                      FontFamily="Consolas, Courier New, monospace"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Row 4: Separator -->
        <Border Grid.Row="4" Grid.ColumnSpan="3"
                    BorderBrush="Gray"
                    BorderThickness="0,1,0,0"
                    Margin="0,15,0,15"/>

        <!-- Row 5: Base path label
             DestinationPathTextBox holds the "base path" the user selects.
             The actual import target is derived in code as:
               basePath \ [author] \ folderName   (when no existing author folder)
               basePath \ folderName              (when an existing author folder was chosen as basePath)
        -->
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                   x:Name="BasePathLabel"
                   Text="Recommended base path:"
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <!-- Row 6: Base path textbox + Explore -->
        <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                 x:Name="DestinationPathTextBox"
                 Margin="0,0,10,0"
                 TextChanged="DestinationPathTextBox_TextChanged"/>
        <Button Grid.Row="6" Grid.Column="2"
                Content="Explore..."
                Click="ExploreButton_Click"
                MinWidth="80"/>

        <!-- Row 7: Final path preview — shows the real folder that will be created -->
        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                x:Name="FinalPathPreviewBorder"
                Background="#1A90C8FF"
                BorderBrush="#4090C8FF"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,5"
                Margin="0,8,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁 Import destination: "
                           Foreground="#90C8FF"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FinalPathPreviewText"
                           Foreground="#C8E8FF"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Row 8: Tags -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Margin="0,15,0,0">
            <TextBlock Text="Tags to apply to imported folders: "
               Foreground="White"
               Margin="0,5,0,5"/>
            <Grid>
                <TextBox Text="{Binding TagInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 x:Name="TagsTextBox">
                    <TextBox.ToolTip>
                        <ToolTip>
                            <StackPanel>
                                <TextBlock Text="Tag Format Examples:" FontWeight="Bold"/>
                                <TextBlock Text="• Simple tags: #nature #sunset #beach"/>
                                <TextBlock Text="• Tags with categories: #Landscape::mountain #Season::winter"/>
                                <TextBlock Text="• Tags with spaces: #photon book #digital art"/>
                                <TextBlock Text="• Mixed format: #clothing::glasses # photon book #IP"/>
                                <TextBlock Text="• Spaces around # are ignored: # nature #  sunset  #beach"/>
                                <TextBlock Text=""/>
                                <TextBlock Text="Rules:" FontWeight="Bold"/>
                                <TextBlock Text="• Use # as the only separator between tags"/>
                                <TextBlock Text="• Spaces before and after # are ignored"/>
                                <TextBlock Text="• Tag names can contain spaces"/>
                                <TextBlock Text="• Use Category::TagName for categorized tags"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                <TextBlock Text="Enter tags with # separator, spaces around # are ignored"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"
                   Foreground="Gray"
                   IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TagsTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- Row 9: Status -->
        <TextBlock Grid.Row="9" Grid.ColumnSpan="3"
                  x:Name="StatusText"
                  Margin="0,15,0,0"
                  Foreground="#AAAAAA"
                  TextWrapping="Wrap"/>

        <!-- Row 10: Buttons -->
        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Cancel" MinWidth="80" Margin="0,0,10,0" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Import" MinWidth="80" Click="Import_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
