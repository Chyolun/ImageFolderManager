<mah:MetroWindow x:Class="ImageFolderManager.Views.ImportFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Import Folders"
        Width="760"
        MinHeight="460"
        MaxHeight="860"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="{DynamicResource App.Brush.Window}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText"
                       Text="Import Folders"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Brush.TextPrimary}"/>
        </Border>

        <!-- Source + Author -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Source Folder:"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="SourceFolderText"
                         Style="{StaticResource AppTextBoxStyle}"
                         Foreground="{StaticResource StatusSuccessBrush}"
                         TextWrapping="Wrap"
                         IsReadOnly="True"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Author:"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,10,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         x:Name="AuthorTextBox"
                         Style="{StaticResource AppTextBoxStyle}"
                         Foreground="{DynamicResource App.Brush.TextPrimary}"
                         Margin="0,10,0,0"
                         TextChanged="AuthorTextBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Skip Info -->
        <StackPanel Grid.Row="2"
                    x:Name="SkipInfoPanel"
                    Visibility="Collapsed"
                    Margin="0,0,0,10">
            <Border Style="{StaticResource SectionCard}"
                    Background="{DynamicResource App.Brush.Surface2}"
                    BorderBrush="{StaticResource StatusWarningBrush}">
                <StackPanel>
                    <TextBlock Text="Skipped Folders"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource StatusWarningBrush}"
                               Margin="0,0,0,5"/>
                    <ScrollViewer MaxHeight="120"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SkipInfoText"
                                   Foreground="{DynamicResource App.Brush.TextSecondary}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   LineHeight="16"
                                   FontFamily="Consolas, Courier New, monospace"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Destination -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           x:Name="BasePathLabel"
                           Text="Recommended base path:"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,0,0,5"/>

                <TextBox Grid.Row="1" Grid.Column="0"
                         x:Name="DestinationPathTextBox"
                         Style="{StaticResource AppTextBoxStyle}"
                         Margin="0,0,10,0"
                         TextChanged="DestinationPathTextBox_TextChanged"/>
                <Button Grid.Row="1" Grid.Column="1"
                        Content="Explore..."
                        Click="ExploreButton_Click"
                        MinWidth="90"
                        Style="{StaticResource SecondaryButton}"/>

                <Border Grid.Row="2" Grid.ColumnSpan="2"
                        x:Name="FinalPathPreviewBorder"
                        Background="{DynamicResource App.Brush.Surface2}"
                        BorderBrush="{StaticResource StatusInfoBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,6"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Import destination: "
                                   Foreground="{StaticResource StatusInfoBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="FinalPathPreviewText"
                                   Foreground="{DynamicResource App.Brush.TextPrimary}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <TextBlock Text="Import mode:"
                               Foreground="{DynamicResource App.Brush.TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <RadioButton x:Name="CopyModeRadioButton"
                                 Content="Copy (Recommended)"
                                 IsChecked="True"
                                 Foreground="{DynamicResource App.Brush.TextSecondary}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                    <RadioButton x:Name="MoveModeRadioButton"
                                 Content="Move (Delete source after success)"
                                 Foreground="{DynamicResource App.Brush.TextSecondary}"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tags -->
        <Border Grid.Row="4" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Tags to apply to imported folders:"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,0,0,5"/>
                <Grid>
                    <TextBox Text="{Binding TagInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="TagsTextBox"
                             Style="{StaticResource AppTextBoxStyle}">
                        <TextBox.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock Text="Tag Format Examples:" FontWeight="Bold"/>
                                    <TextBlock Text="- Simple tags: #nature #sunset #beach"/>
                                    <TextBlock Text="- Categories: #Landscape::mountain #Season::winter"/>
                                    <TextBlock Text="- Spaces are allowed inside tag names"/>
                                    <TextBlock Text="- Use # as separator"/>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                    <TextBlock Text="Enter tags with # separator"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TagsTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="5" Style="{StaticResource SectionCard}" Margin="0,0,0,10" Padding="10,8">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource App.Brush.TextMuted}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="6" Style="{StaticResource DialogFooterPanel}">
            <Button Content="Cancel"
                    MinWidth="80"
                    Margin="{StaticResource DialogButtonSpacing}"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"/>
            <Button Content="Import"
                    MinWidth="80"
                    Click="Import_Click"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
