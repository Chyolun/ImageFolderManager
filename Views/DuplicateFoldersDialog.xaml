<mah:MetroWindow x:Class="ImageFolderManager.Views.DuplicateFoldersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:services="clr-namespace:ImageFolderManager.Services"
        mc:Ignorable="d"
        Title="Find Duplicate Folders"
        Height="600"
        Width="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Duplicate Folders Found" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <Button x:Name="FilterSettingsButton"
                    Content="⚙️ Filter Settings" 
                    Click="FilterSettings_Click"
                    Margin="20,0,0,0"
                    Padding="10,5"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Foreground="White"
                    FontSize="11"/>
        </StackPanel>

        <!-- Summary Information -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock x:Name="SummaryText" 
                           Text="Found 0 duplicate folder names" 
                           Foreground="LightBlue"
                           FontSize="12"/>
                <TextBlock Text=" • " 
                           Foreground="Gray" 
                           Margin="10,0"/>
                <TextBlock x:Name="TotalFoldersText" 
                           Text="Total folders: 0" 
                           Foreground="Gray"
                           FontSize="12"/>
            </StackPanel>

            <!-- Filter Information -->
            <TextBlock x:Name="FilterInfoText"
                       Text="Filters disabled • All folders checked"
                       FontSize="11"
                       Foreground="Gray"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Filter Status Panel -->
        <Border Grid.Row="2" 
                Background="{DynamicResource MahApps.Brushes.Gray10}" 
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}" 
                BorderThickness="1" 
                CornerRadius="5" 
                Padding="10" 
                Margin="0,0,0,15"
                Visibility="{Binding Path=EnableDuplicateFilters, Source={x:Static services:AppSettings.Instance}, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <TextBlock Text="🔍 Active Filters" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" 
                           FontSize="12" 
                           Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="• Minimum folder name length: " 
                               Foreground="LightGray" 
                               FontSize="11"/>
                    <TextBlock Text="{Binding Path=MinFolderNameLength, Source={x:Static services:AppSettings.Instance}}" 
                               Foreground="White" 
                               FontSize="11" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" characters" 
                               Foreground="LightGray" 
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="• Excluded folder names: " 
                               Foreground="LightGray" 
                               FontSize="11"/>
                    <TextBlock Text="{Binding Path=ExcludedFolderNames.Count, Source={x:Static services:AppSettings.Instance}}" 
                               Foreground="White" 
                               FontSize="11" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" entries" 
                               Foreground="LightGray" 
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DuplicateGroupsPanel" Margin="0,0,10,0">
                <!-- Dynamic content will be added here -->
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{DynamicResource MahApps.Brushes.Gray10}" 
                BorderBrush="Gray" 
                BorderThickness="0,1,0,0" 
                Padding="10,8" 
                Margin="0,15,0,0">
            <TextBlock x:Name="StatusText" 
                       Text="Ready" 
                       Foreground="LightGray" 
                       FontSize="11"/>
        </Border>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">

            <Button Content="🔄 Refresh" 
                    Click="Refresh_Click" 
                    Margin="0,0,10,0" 
                    Padding="15,8" 
                    MinWidth="100"
                    Background="DarkOrange"
                    Foreground="White"/>

            <Button Content="Close" 
                    Click="Close_Click" 
                    IsCancel="True" 
                    Padding="15,8" 
                    MinWidth="80"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>