<mah:MetroWindow x:Class="ImageFolderManager.Views.DuplicateFoldersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:services="clr-namespace:ImageFolderManager.Services"
        mc:Ignorable="d"
        Title="Find Duplicate Folders"
        Height="600"
        Width="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Brush.Window}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Duplicate Folders Found" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="FilterSettingsButton"
                        Content="Filter Settings" 
                        Click="FilterSettings_Click"
                        MinWidth="118"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="11"/>
            </Grid>
        </Border>

        <!-- Summary Information -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock x:Name="SummaryText" 
                               Text="Found 0 duplicate folder names" 
                               Foreground="{StaticResource StatusInfoBrush}"
                               FontSize="12"/>
                    <TextBlock Text=" • " 
                               Foreground="{DynamicResource App.Brush.TextMuted}" 
                               Margin="10,0"/>
                    <TextBlock x:Name="TotalFoldersText" 
                               Text="Total folders: 0" 
                               Foreground="{DynamicResource App.Brush.TextMuted}"
                               FontSize="12"/>
                </StackPanel>

                <TextBlock x:Name="FilterInfoText"
                           Text="Filters disabled • All folders checked"
                           FontSize="11"
                           Foreground="{DynamicResource App.Brush.TextMuted}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Filter Status Panel -->
        <Border Grid.Row="2" 
                Style="{StaticResource SectionCard}"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}" 
                Margin="0,0,0,15"
                Visibility="{Binding Path=EnableDuplicateFilters, Source={x:Static services:AppSettings.Instance}, Converter={StaticResource BooleanToVisibilityConverter}}">

            <StackPanel>
                <TextBlock Text="Active Filters" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource MahApps.Brushes.Accent}" 
                           FontSize="12" 
                           Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="• Minimum folder name length: " 
                               Foreground="{DynamicResource App.Brush.TextSecondary}" 
                               FontSize="11"/>
                    <TextBlock Text="{Binding Path=MinFolderNameLength, Source={x:Static services:AppSettings.Instance}}" 
                               Foreground="{DynamicResource App.Brush.TextPrimary}" 
                               FontSize="11" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" characters" 
                               Foreground="{DynamicResource App.Brush.TextSecondary}" 
                               FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="• Excluded folder names: " 
                               Foreground="{DynamicResource App.Brush.TextSecondary}" 
                               FontSize="11"/>
                    <TextBlock Text="{Binding Path=ExcludedFolderNames.Count, Source={x:Static services:AppSettings.Instance}}" 
                               Foreground="{DynamicResource App.Brush.TextPrimary}" 
                               FontSize="11" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" entries" 
                               Foreground="{DynamicResource App.Brush.TextSecondary}" 
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DuplicateGroupsPanel" Margin="0,0,10,0">
                    <!-- Dynamic content will be added here -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                Style="{StaticResource SectionCard}"
                Padding="10,8"
                Margin="0,15,0,0">
            <TextBlock x:Name="StatusText" 
                       Text="Ready" 
                       Foreground="{DynamicResource App.Brush.TextSecondary}" 
                       FontSize="11"/>
        </Border>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="5" 
                    Style="{StaticResource DialogFooterPanel}">

            <Button Content="Refresh" 
                    Click="Refresh_Click" 
                    Padding="15,8" 
                    MinWidth="100"
                    Margin="{StaticResource DialogButtonSpacing}"
                    Style="{StaticResource SecondaryButton}"/>

            <Button Content="Close" 
                    Click="Close_Click" 
                    IsCancel="True" 
                    Padding="15,8" 
                    MinWidth="80"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
