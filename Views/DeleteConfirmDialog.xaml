<mah:MetroWindow x:Class="ImageFolderManager.Views.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Confirm Delete"
        Height="240"
        Width="440"
        MinHeight="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <!-- Icon + main message -->
            <RowDefinition Height="Auto"/>
            <!-- Detail / folder list -->
            <RowDefinition Height="*"/>
            <!-- Recycle Bin note -->
            <RowDefinition Height="Auto"/>
            <!-- Button footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning icon + main message -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <!-- Warning triangle drawn inline, no font dependency -->
            <Viewbox Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Top">
                <Canvas Width="24" Height="24">
                    <Path Fill="{StaticResource StatusWarningBrush}"
                          Data="M1,21H23L12,2L1,21Z M13,18H11V16H13V18Z M13,14H11V10H13V14Z"/>
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
        </StackPanel>

        <!--
            Detail area: shown for multi-folder deletes as a scrollable list,
            or as a single selectable path for single-folder deletes.
            Visibility is controlled from code-behind.
        -->
        <Border Grid.Row="1"
                x:Name="DetailBorder"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="80">
                <ItemsControl x:Name="FolderList"
                              Margin="6,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Each path is a read-only TextBox so the user
                                can select and copy a path before confirming.
                            -->
                            <TextBox Text="{Binding Mode=OneWay}"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,1"
                                     Cursor="IBeam"
                                     FontSize="11"
                                     Foreground="{StaticResource StatusMutedBrush}"
                                     TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Recycle Bin notice -->
        <TextBlock Grid.Row="2"
                   Text="The selected folder(s) will be moved to the Recycle Bin."
                   FontSize="11"
                   Foreground="{StaticResource StatusMutedBrush}"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <!-- Footer: Cancel (secondary) + Delete (danger) -->
        <StackPanel Grid.Row="3"
                    Style="{StaticResource DialogFooterPanel}">

            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="{StaticResource DialogButtonSpacing}"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Content="Delete"
                    Style="{StaticResource DangerButton}"
                    IsDefault="True"
                    Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
