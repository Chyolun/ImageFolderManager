<mah:MetroWindow x:Class="ImageFolderManager.Views.PreviewSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Performance Settings"
        Height="560"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="{DynamicResource App.Brush.Window}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <TextBlock Text="Performance Settings"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource App.Brush.TextPrimary}"/>
        </Border>

        <!-- Preview section -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Preview Size"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Width:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,0,10,0"/>
                <mah:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="WidthUpDown" Style="{StaticResource AppNumericUpDownStyle}" Minimum="100" Maximum="1000" Interval="10" Value="200"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Height:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,10,10,0"/>
                <mah:NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="HeightUpDown" Style="{StaticResource AppNumericUpDownStyle}" Margin="0,10,0,0" Minimum="100" Maximum="1000" Interval="10" Value="300"/>
            </Grid>
        </Border>

        <!-- Cache section -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="Cache and Threads"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Max Cache in Memory (MB):"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,0,10,0"/>
                <mah:NumericUpDown Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MaxCacheSizeUpDown" Style="{StaticResource AppNumericUpDownStyle}" Minimum="100" Maximum="2024" Interval="50" Value="300"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Parallel Threads:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,10,10,0"/>
                <mah:NumericUpDown Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ThreadCountUpDown" Style="{StaticResource AppNumericUpDownStyle}" Margin="0,10,0,0" Minimum="1" Maximum="16" Interval="1" Value="3"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Local Cache:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Brush.TextPrimary}"
                           Margin="0,12,10,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           x:Name="CacheSizeText"
                           Text="Calculating..."
                           Margin="0,12,10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StatusSuccessBrush}"
                           FontWeight="SemiBold"/>
                <Button Grid.Row="3" Grid.Column="2"
                        Content="Clear Cache"
                        MinWidth="108"
                        Margin="0,10,0,0"
                        Click="ClearCache_Click"
                        Style="{StaticResource DangerButton}"/>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                           Text="Clearing cache removes local thumbnails. They will be regenerated on next load."
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource App.Brush.TextMuted}"
                           FontSize="11"/>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0,0,0,10" Padding="10,8">
            <TextBlock Text="Tip: Larger preview sizes and higher thread counts may increase memory usage."
                       Foreground="{DynamicResource App.Brush.TextSecondary}"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Style="{StaticResource DialogFooterPanel}">
            <Button Content="Cancel" MinWidth="80" Margin="{StaticResource DialogButtonSpacing}" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            <Button Content="Apply" MinWidth="80" Click="Apply_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
