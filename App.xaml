<Application x:Class="ImageFolderManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ImageFolderManager.Converters"
             xmlns:controls="clr-namespace:ImageFolderManager.Controls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:RatingToStarsDisplayConverter x:Key="RatingToStarsDisplayConverter"/>
            <converters:TagsToStringConverter x:Key="TagsToStringConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:HasTagsToVisibilityConverter x:Key="HasTagsToVisibilityConverter"/>

            <!-- Spacing scale -->
            <Thickness x:Key="Space.1">4</Thickness>
            <Thickness x:Key="Space.2">8</Thickness>
            <Thickness x:Key="Space.3">12</Thickness>
            <Thickness x:Key="Space.4">16</Thickness>
            <Thickness x:Key="Space.5">24</Thickness>

            <!-- Core palette -->
            <SolidColorBrush x:Key="App.Brush.Window" Color="#FF0E1520"/>
            <SolidColorBrush x:Key="App.Brush.Surface1" Color="#FF182230"/>
            <SolidColorBrush x:Key="App.Brush.Surface2" Color="#FF1E2A3A"/>
            <SolidColorBrush x:Key="App.Brush.Surface3" Color="#FF243245"/>
            <SolidColorBrush x:Key="App.Brush.Border" Color="#FF2D4058"/>
            <SolidColorBrush x:Key="App.Brush.BorderStrong" Color="#FF416B9D"/>
            <SolidColorBrush x:Key="App.Brush.TextPrimary" Color="#FFEAF0F7"/>
            <SolidColorBrush x:Key="App.Brush.TextSecondary" Color="#FFB8C2D1"/>
            <SolidColorBrush x:Key="App.Brush.TextMuted" Color="#FF8A95A8"/>
            <SolidColorBrush x:Key="App.Brush.Hover" Color="#FF2B3B4E"/>
            <SolidColorBrush x:Key="App.Brush.Selection" Color="#FF1E4E7A"/>
            <SolidColorBrush x:Key="App.Brush.TagChip" Color="#FF1D3E35"/>
            <SolidColorBrush x:Key="App.Brush.TagChipBorder" Color="#FF2E7563"/>
            <SolidColorBrush x:Key="App.Brush.SuccessSoft" Color="#223CB179"/>

            <!-- Semantic brushes -->
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4EC94E"/>
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#58A6FF"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#E3B341"/>
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#F85149"/>
            <SolidColorBrush x:Key="StatusMutedBrush" Color="#6E7681"/>

            <!-- Shared controls -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface1}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10"/>
            </Style>

            <Style x:Key="SectionTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
            </Style>

            <Style x:Key="MenuGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="AppTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="MinHeight" Value="30"/>
            </Style>

            <Style x:Key="AppNumericUpDownStyle"
                   TargetType="{x:Type mah:NumericUpDown}"
                   BasedOn="{StaticResource {x:Type mah:NumericUpDown}}">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource App.Brush.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusChipBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource App.Brush.SuccessSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,2"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.88"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface2}"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource App.Brush.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="#C0392B"/>
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="#A93226"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.88"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DialogFooterPanel" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,16,0,0"/>
            </Style>

            <Thickness x:Key="DialogButtonSpacing">0,0,8,0</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
