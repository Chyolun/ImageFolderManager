<Application x:Class="ImageFolderManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ImageFolderManager.Converters"
             xmlns:controls="clr-namespace:ImageFolderManager.Controls" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- =====================================================================
                 Converters
                 ===================================================================== -->
            <converters:RatingToStarsDisplayConverter x:Key="RatingToStarsDisplayConverter"/>
            <converters:TagsToStringConverter         x:Key="TagsToStringConverter"/>
            <converters:CountToVisibilityConverter    x:Key="CountToVisibilityConverter"/>
            <converters:HasTagsToVisibilityConverter  x:Key="HasTagsToVisibilityConverter"/>

            <!-- =====================================================================
                 Semantic Status Brushes
                 Used for status text, badges, and highlights throughout the app.
                 Always reference these keys instead of hardcoding colors.
                 ===================================================================== -->

            <!-- Success: folder selected count, rename completed, etc. -->
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4EC94E"/>

            <!-- Info: hints, tag counts, secondary labels -->
            <SolidColorBrush x:Key="StatusInfoBrush"    Color="#58A6FF"/>

            <!-- Warning: overwrite prompts, unsaved changes -->
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#E3B341"/>

            <!-- Error: failed operations, validation errors -->
            <SolidColorBrush x:Key="StatusErrorBrush"   Color="#F85149"/>

            <!-- Muted: placeholder text, secondary descriptions -->
            <SolidColorBrush x:Key="StatusMutedBrush"   Color="#6E7681"/>

            <!-- =====================================================================
                 Dialog Button Styles
                 Three variants cover every action button in the application.

                 Usage guide:
                   PrimaryButton   — confirming action  (OK, Apply, Save, Import, Rename)
                   SecondaryButton — neutral/cancel      (Cancel, Close, Back)
                   DangerButton    — destructive action  (Delete, Clear Cache, Reset)

                 Always pair IsDefault="True" with PrimaryButton and
                 IsCancel="True" with SecondaryButton on dialog windows.
                 ===================================================================== -->

            <!--
                PrimaryButton
                Inherits MahApps base button, overrides background with the
                active accent color so it stands out as the default action.
            -->
            <Style x:Key="PrimaryButton" TargetType="Button"
                   BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="MinWidth"    Value="88"/>
                <Setter Property="Height"      Value="32"/>
                <Setter Property="Padding"     Value="12,0"/>
                <Setter Property="Background"  Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Setter Property="Foreground"  Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                <Style.Triggers>
                    <!-- Slightly darken on hover to provide click affordance -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <!-- Visually suppress when disabled -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                SecondaryButton
                Uses the default MahApps appearance — blends with the dialog
                background, signalling a non-destructive, dismissal action.
            -->
            <Style x:Key="SecondaryButton" TargetType="Button"
                   BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height"   Value="32"/>
                <Setter Property="Padding"  Value="12,0"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                DangerButton
                Red background signals an irreversible or destructive operation.
                Use for: Delete Folder, Clear Cache, Reset to Defaults.
                Always show a confirmation dialog before executing the action.
            -->
            <Style x:Key="DangerButton" TargetType="Button"
                   BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="MinWidth"    Value="88"/>
                <Setter Property="Height"      Value="32"/>
                <Setter Property="Padding"     Value="12,0"/>
                <Setter Property="Background"  Value="#C0392B"/>
                <Setter Property="Foreground"  Value="White"/>
                <Setter Property="BorderBrush" Value="#A93226"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- =====================================================================
                 Standard Dialog Footer Panel Style
                 Apply this style to the StackPanel that holds OK/Cancel buttons
                 at the bottom of every dialog to ensure uniform spacing.

                 Example usage in a dialog:
                     <StackPanel Style="{StaticResource DialogFooterPanel}">
                         <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                 IsCancel="True" Click="Cancel_Click"/>
                         <Button Content="Apply"  Style="{StaticResource PrimaryButton}"
                                 IsDefault="True" Click="Apply_Click"/>
                     </StackPanel>
                 ===================================================================== -->
            <Style x:Key="DialogFooterPanel" TargetType="StackPanel">
                <Setter Property="Orientation"        Value="Horizontal"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin"             Value="0,16,0,0"/>
            </Style>

            <Style TargetType="{x:Type controls:AnimatedImageControl}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:AnimatedImageControl}">
                            <Image x:Name="PART_Image"
                       Stretch="{TemplateBinding Stretch}"
                       Width="{TemplateBinding Width}"
                       Height="{TemplateBinding Height}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAnimated}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Spacing helper: apply as Margin on every button except the last
                to keep a consistent 8 px gap between sibling buttons.

                Example:
                    <Button ... Margin="{StaticResource DialogButtonSpacing}"/>
                    <Button .../>
            -->
            <Thickness x:Key="DialogButtonSpacing">0,0,8,0</Thickness>

        </ResourceDictionary>
    </Application.Resources>
</Application>
